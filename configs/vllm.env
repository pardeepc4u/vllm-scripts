# ============================================================================
# vLLM Environment Configuration
# Hardware: 2x RTX 3090 (24GB) + 1x RTX 3080 (10GB)
# ============================================================================

# Base paths
VLLM_INSTALL_DIR="/opt/vllm"
VENV_DIR="${VLLM_INSTALL_DIR}/.venv"
MODEL_DIR="${VLLM_INSTALL_DIR}/models"
LOG_DIR="${VLLM_INSTALL_DIR}/logs"

# User to run vLLM as
VLLM_USER="vllm"
VLLM_GROUP="vllm"

# Common settings
DEFAULT_HOST="0.0.0.0"
DEFAULT_DTYPE="auto"
DEFAULT_TRUST_REMOTE_CODE="true"
