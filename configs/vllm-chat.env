# ============================================================================
# Chat + Agent Model: Qwen 3.5 27B Dense on GPU 0 (RTX 3090)
# Single instance serving both chat and agent endpoints
# ============================================================================

# Model settings
MODEL_NAME="Qwen/Qwen3.5-27B-Dense"
SERVED_MODEL_NAME="chat"
SERVED_MODEL_NAME_2="agent"
PORT=8001

# GPU settings
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
QUANTIZATION="awq_marlin"

# Agent/Tool calling
ENABLE_AUTO_TOOL_CHOICE="true"
TOOL_CALL_PARSER="hermes"

# Resource limits
CPUAffinity=0-7
Nice=0
